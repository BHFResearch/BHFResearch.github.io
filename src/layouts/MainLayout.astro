---
import Search from '../components/Search.astro';
const { title = "Better Health Facts" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <meta
    name="description"
    content={Astro.props.description || "Better Health Research Articles"}
  />

  <link rel="canonical" href={Astro.url} />

  <meta property="og:type" content="article" />
  <meta property="og:title" content={Astro.props.title} />
  <meta property="og:description" content={Astro.props.description} />
  <meta property="og:url" content={Astro.url} />

  <!-- ADSENSE -->
  <script
    async
    crossorigin="anonymous"
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0770728525587553">
  </script>

  <!-- UMAMI -->
  <script
    defer
    src="https://cloud.umami.is/script.js"
    data-website-id="e41c2d07-e2b3-433b-a54f-53db54317699">
  </script>

  <!-- GA4 -->
  <script
    async
    src="https://www.googletagmanager.com/gtag/js?id=G-08PH0RXVZP">
  </script>

  <script>
    window.dataLayer = window.dataLayer || [];

    function gtag(){dataLayer.push(arguments);}

    gtag('js', new Date());

    gtag('config', 'G-08PH0RXVZP');
  </script>

  <style is:global>

    :root {
      --bg: #020617;
      --surface: #0f172a;
      --surface-2: #111827;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #000000;
      --border: rgba(255,255,255,0.08);
      --radius: 22px;
	  --pagefind-ui-text: #dddddd;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;

      font-family:
        Inter,
        system-ui,
        sans-serif;

      background:
        radial-gradient(
          circle at top,
          #0f172a,
          #020617 60%
        );

      color: var(--text);

      overflow-x: hidden;
    }

    a {
	  color: #7dd3fc;              /* soft sky blue – already used in your search results */
	  text-decoration: none;
	  transition: color 0.2s ease;
	}

	a:hover {
	  color: #bae6fd;              /* lighter on hover */
	  text-decoration: underline;
	}

	a:visited {
	  color: #67e8f9;              /* slightly different cyan so visited links are still readable */
	}

    /* HEADER */

    header {
      background: var(--primary);

      color: white;

      padding: 2px 10px;

      position: sticky;
      top: 0;
      z-index: 1000;

      overflow-x: hidden;
    }

	.header-inner {
	  max-width: 1400px;

	  margin: auto;

	  display: flex;

	  justify-content: center;
	  align-items: center;

	  gap: 10px;
	}

	.logo {
	  display: flex;
	  align-items: center;
	}

	.logo img {
	  height: 70px;
	  width: auto;
	  display: block;
	}

    nav {
      display: flex;
      align-items: center;

      gap: 16px;

      flex-wrap: wrap;
    }

    nav a {
      color: white;
      font-weight: 600;

      white-space: nowrap;
    }

    nav a:hover {
      text-decoration: underline;
    }

    /* SEARCH */

    #search {
      width: 100%;
      max-width: 320px;

      min-width: 0;

      flex: 1 1 260px;
    }

    .pagefind-ui {
      width: 100%;
      max-width: 320px;

      min-width: 0;
    }

    .pagefind-ui__search-input {
      width: 100% !important;

      min-width: 0 !important;

      box-sizing: border-box;
    }
	
	/* Search result title */
	.pagefind-ui__result-title a {
	  color: #f8fafc !important;
	  font-weight: 600;
	}

	/* Search result excerpt */
	.pagefind-ui__result-excerpt {
	  color: #cbd5e1 !important;
	  line-height: 1.7;
	}

	/* URL/meta text */
	.pagefind-ui__result-link {
	  color: #7dd3fc !important;
	}

	/* Search box text */
	.pagefind-ui__search-input {
	  color: #f8fafc !important;
	  background: #111827 !important;
	}

	/* Search box placeholder */
	.pagefind-ui__search-input::placeholder {
	  color: #94a3b8 !important;
	}

    /* MAIN */

    main {
      max-width: 1400px;

      margin: auto;

      padding: 10px 30px;
    }

	/* Related Articles Grid */
	.related-grid {
	  display: grid;
	  grid-template-columns: repeat(3, 1fr);
	  gap: 24px;
	  margin-top: 20px;
	}

	@media (max-width: 900px) {
	  .related-grid {
		grid-template-columns: 1fr;
	  }
	}
	
	/* Related Articles Cards - Dark Theme */
	.card {
	  position: relative;
	  border-radius: 16px;
	  overflow: hidden;
	  background: #0f172a;
	  border: 1px solid rgba(255, 255, 255, 0.1);
	  transition: 0.25s ease;
	}

	.card:hover {
	  transform: translateY(-4px);
	  border-color: rgba(125, 211, 252, 0.45);
	  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
	}

	.card a {
	  display: block;
	  color: inherit;
	  text-decoration: none;
	  height: 100%;
	}

	.card img {
	  width: 100%;
	  height: 220px;
	  object-fit: cover;
	  display: block;
	}
	
	/* Title over image with gradient */
	.card-title-overlay {
	  position: absolute;
	  bottom: 0;
	  left: 0;
	  right: 0;
	  padding: 28px 18px 18px;
	  background: linear-gradient(
		to top,
		rgba(2, 6, 23, 0.92) 0%,
		rgba(2, 6, 23, 0.75) 55%,
		transparent 100%
	  );
	}

	.card-title-overlay h4 {
	  margin: 0;
	  font-size: 1.05rem;
	  line-height: 1.4;
	  color: #f8fafc;
	  font-weight: 600;
	}

	/* Footer - keep it light or make it dark */
	footer {
	  background: #0f172a;
	  color: #94a3b8;
	  border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	footer a {
	  color: #7dd3fc;
	}

    /* MOBILE */

	@media (max-width: 768px) {

	  .logo img {
		height: 90px;
	  }

	  .header-inner {
		justify-content: center;
		gap: 8px;
	  }

	  main {
		padding: 10px 15px;
	  }

	}
	
	/* Search Icon */

	.search-toggle {
	  background: rgba(255,255,255,0.08);

	  border: 1px solid rgba(255,255,255,0.12);

	  border-radius: 999px;

	  color: white;

	  font-size: 1.7rem;

	  cursor: pointer;

	  width: 55px;
	  height: 55px;

	  display: flex;
	  align-items: center;
	  justify-content: center;

	  transition: 0.2s ease;
	}

	.search-toggle:hover {
	  background: rgba(125,211,252,0.15);
	}

	/* Overlay */

	.search-overlay {
	  position: fixed;

	  inset: 0;

	  background: rgba(2,6,23,0.96);

	  display: none;

	  overflow-y: auto;

	  padding: 80px 20px 40px;

	  z-index: 9999;
	}

	.search-overlay.open {
	  display: flex;
	}

	/* Content */

	.search-overlay-content {
	  width: min(900px, 92vw);

	  margin: 0 auto;

	  max-height: calc(100vh - 120px);

	  overflow-y: auto;
	}
	

	/* Close Button */

	.search-close {
	  background: transparent;
	  border: none;

	  color: white;

	  font-size: 2rem;

	  cursor: pointer;

	  float: right;

	  margin-bottom: 20px;
	}

	.search-overlay h2 {
	  color: white;

	  margin-bottom: 20px;

	  font-size: 2rem;
	}

	/* Bigger Search */

	.search-overlay .pagefind-ui {
	  max-width: none;
	  width: 100%;
	}

	.search-overlay .pagefind-ui__search-input {
	  position: sticky;
	  top: 0;

	  z-index: 10;

	  background: #111827;
	}

	/* Mobile */

	@media (max-width: 768px) {

	  .search-overlay {
		padding-top: 60px;
	  }

	  .search-overlay-content {
		width: 95vw;
	  }

	}

  </style>

</head>

<body>

<header>

  <div class="header-inner">

	<a href="/" class="logo">
	  <img
		src="/images/logo.jpg"
		alt="Better Health Facts Research"
		width="286"
		height="80"
	  />
	</a>

	<button id="search-toggle" class="search-toggle" aria-label="Search">
	  🔍
	</button>

  </div>

</header>

<div id="search-overlay" class="search-overlay">

  <div class="search-overlay-content">

    <button
      id="search-close"
      class="search-close"
      aria-label="Close Search">
      ✕
    </button>

    <h2>Search Articles</h2>

    <Search />

  </div>

</div>

<main>
  <slot />
</main>

<footer>
  © {new Date().getFullYear()} BetterHealthFacts Research. 
      &nbsp;&nbsp;<a href="/about/">About</a>
      &nbsp;&nbsp;<a href="/disclaimer/">Disclaimer</a>
</footer>

<script>
document.addEventListener('DOMContentLoaded', () => {

  const overlay = document.getElementById('search-overlay');

  const openBtn = document.getElementById('search-toggle');

  const closeBtn = document.getElementById('search-close');

  openBtn.addEventListener('click', () => {

    overlay.classList.add('open');

    document.body.style.overflow = 'hidden';

  });

  closeBtn.addEventListener('click', () => {

    overlay.classList.remove('open');

    document.body.style.overflow = '';

  });

  document.addEventListener('keydown', (e) => {

    if (e.key === 'Escape') {

      overlay.classList.remove('open');

      document.body.style.overflow = '';

    }

  });

});
</script>

</body>
</html>