---
---

    <div class="container">

        <!-- Welcome -->
        <div id="welcome" class="section active">
            <div class="header"><h1>🩺 Digital Audiometer</h1></div>
            <h2>Welcome to Better Health Facts Hearing Test</h2>
            <p>This tool simulates professional audiometers (like ALPS) for educational purposes only.</p>
			<h3>How it works:</h3>
            <ul>
                <li>You will hear pure tones at different frequencies and volumes.</li>
                <li>We test both ears separately.</li>
                <li>You adjust volume until you just barely hear the tone, then record the threshold.</li>
            </ul>
            <button class="primary" onclick="nextSection('setup')" style="font-size:18px;padding:15px 30px;">Start Test</button>
        </div>

        <!-- Setup -->
        <div id="setup" class="section">
            <h2>Setup & Calibration</h2>
            <p><strong>Use Headphones</strong> • Set device volume to 30%–35%</p>
            <button style="background:#15803d; color:white; border:none; padding:18px 50px; font-size:20px; border-radius:50px; box-shadow:0 4px 15px rgba(21,128,61,0.3);" onclick="playCalibration('left')">Play Left Ear (1000 Hz)</button>
            <button style="background:#15803d; color:white; border:none; padding:18px 50px; font-size:20px; border-radius:50px; box-shadow:0 4px 15px rgba(21,128,61,0.3);" onclick="playCalibration('right')">Play Right Ear (1000 Hz)</button>
            <button onclick="stopTone()" style="background:#b91c1c;">Stop</button>
            <p style="margin-top:20px;">Adjust your device volume until the tone is comfortable in both ears.</p>
            <button class="primary" onclick="nextSection('instructions')">Continue to Instructions</button>
        </div>
		
		
		<!-- Instructions Section -->
        <div id="instructions" class="section">
            <h2>How to Use the Audiometer</h2>
            <ol style="line-height:1.8; font-size:16px;">
                <li><strong>Select Ear</strong> (Left or Right)</li>
                <li><strong>Choose Frequency</strong> from the dropdown</li>
                <li><strong>Adjust Intensity (dB)</strong> using the slider</li>
                <li>Click <strong>"▶ Play Tone"</strong> to hear the sound in the selected ear</li>
                <li>Lower the dB until you can <strong>just barely hear</strong> the tone</li>
                <li>Click <strong>"✅ Record as Threshold"</strong> to save the result</li>
                <li>Repeat for all frequencies and both ears</li>
                <li>Click <strong>"Show Results Now"</strong> to see your audiogram and analysis</li>
            </ol>
            <p><strong>Tip:</strong> Start with higher dB (40-50) and gradually decrease until the tone is just audible.</p>
            <button class="primary" onclick="nextSection('mainapp')" style="font-size:17px;padding:14px 30px;">Start Testing →</button>
        </div>

        <!-- Main Test -->
                <!-- Main Audiometer Control -->
        <div id="mainpp" class="section">
            <div class="header"><h2>🎛️ Audiometer Control Panel</h2></div>

            <div style="display: flex; flex-wrap: wrap; gap: 25px; padding: 25px;">

                <!-- Left Side: Controls -->
                <div style="flex: 1; min-width: 320px;">
                    <div style="background:#f8fafc; padding:30px 25px; border-radius:12px; border:1px solid #e2e8f0;">
                        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:20px;">
                            
                            <!-- Ear Selection -->
                            <div>
                                <label style="font-weight:bold; display:block; margin-bottom:8px; color:#1e3a8a;">Ear</label>
                                <select id="ear" style="width:100%; padding:14px; font-size:16px; border:2px solid #cbd5e1; border-radius:8px;">
                                    <option value="left">Left Ear (🔵)</option>
                                    <option value="right">Right Ear (🔴)</option>
                                </select>
                            </div>

                            <!-- Frequency -->
                            <div>
                                <label style="font-weight:bold; display:block; margin-bottom:8px; color:#1e3a8a;">Frequency</label>
                                <select id="frequency" style="width:100%; padding:14px; font-size:16px; border:2px solid #cbd5e1; border-radius:8px;">
                                    <option value="250">250 Hz</option>
                                    <option value="500">500 Hz</option>
                                    <option value="1000" selected>1000 Hz (Reference)</option>
                                    <option value="2000">2000 Hz</option>
                                    <option value="4000">4000 Hz</option>
                                    <option value="8000">8000 Hz</option>
                                </select>
                            </div>

                            <!-- Intensity Slider -->
                            <div>
                                <label style="font-weight:bold; display:block; margin-bottom:8px; color:#1e3a8a;">
                                    Intensity: <span id="db-value" style="color:#1e40af; font-size:20px;">40</span> dB HL
                                </label>
                                <input type="range" id="intensity" min="0" max="90" value="40" step="5" 
                                       style="width:100%; accent-color:#1e40af;">
                            </div>
                        </div>
                    </div>

                    <!-- Play Button -->
                    <div style="text-align:center; margin:25px 0;">
                        <button id="playBtn" onclick="toggleTone()" 
                                style="background:#15803d; color:white; border:none; padding:18px 60px; font-size:20px; border-radius:50px; box-shadow:0 4px 15px rgba(21,128,61,0.3);">
                            ▶ Play Tone
                        </button>
                    </div>

                    <!-- Action Buttons -->
                    <div style="display:flex; gap:12px; flex-wrap:wrap; padding:0 10px;">
                        <button onclick="recordThreshold()" 
                                style="flex:1; padding:16px; font-size:17px; background:#1e40af; color:white; border-radius:8px;">
                            ✅ Record as Threshold
                        </button>
                        <button onclick="showResults()" 
                                style="flex:1; padding:16px; font-size:17px; background:#64748b; color:white; border-radius:8px;">
                            📊 Show Results
                        </button>
                    </div>
                </div>

                <!-- Right Side: Live Audiogram -->
                <div style="flex: 1; min-width: 380px;">
                    <h3 style="text-align:center; margin-bottom:15px; color:#1e3a8a;">Live Audiogram</h3>
                    <canvas id="audiogram" width="820" height="420" style="width:100%; height:auto; border:2px solid #e2e8f0; border-radius:12px;"></canvas>
                </div>

            </div>
        </div>

        <!-- Results -->
        <div id="results" class="section">
            <h2>Your Hearing Test Results</h2>
            <canvas id="final-audiogram" width="820" height="420"></canvas>
            
            <div id="analysis" class="disclaimer" style="margin-top:25px;"></div>
            
            <div style="text-align:center; margin-top:30px;">
                <button onclick="restartApp()" class="primary" style="padding:15px 30px; font-size:18px; margin-right:10px;">
                    Retake Test
                </button>
                <button onclick="saveAsPDF()" 
                        style="padding:15px 30px; font-size:18px; background:#10b981; color:white;">
                    💾 Save Report as PDF
                </button>
            </div>
        </div>
    </div>

    <script>
		// Author : Prixit Parashar
		// Website : https://www.betterhealthfacts.com/
		// Unauthorized usage of this script by anyone can lead to legal copyright actions.
		// If you want to use this script then contact prixitparashar@gmail.com.
	
        let audioContext, oscillator = null, gainNode = null, panner = null;
        let isPlaying = false;
        let thresholds = { left: {}, right: {} };

        const frequencies = [250, 500, 1000, 2000, 4000, 8000];
        const freqPositions = {250:100, 500:200, 1000:300, 2000:400, 4000:500, 8000:600};

        function initAudio() {
            if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }

        function toggleTone() {
            if (isPlaying) stopTone();
            else playCurrentTone();
        }

        function playCurrentTone() {
            initAudio(); stopTone();
            const freq = parseInt(document.getElementById('frequency').value);
            const db = parseInt(document.getElementById('intensity').value);
            const ear = document.getElementById('ear').value;

            const gainVal = Math.max(0.08, Math.pow(10, (db-65)/20) * 0.4);

            oscillator = audioContext.createOscillator();
            gainNode = audioContext.createGain();
            panner = audioContext.createStereoPanner();

            oscillator.frequency.value = freq;
            gainNode.gain.value = gainVal;
            panner.pan.value = ear === 'left' ? -0.92 : 0.92;

            oscillator.connect(gainNode).connect(panner).connect(audioContext.destination);
            oscillator.start();

            isPlaying = true;
            document.getElementById('playBtn').innerHTML = '⏹ Stop';
            document.getElementById('playBtn').classList.add('playing');
        }

        function stopTone() {
            if (oscillator) { oscillator.stop(); oscillator = null; }
            isPlaying = false;
            document.getElementById('playBtn').innerHTML = '▶ Play Tone';
            document.getElementById('playBtn').classList.remove('playing');
        }

        function playCalibration(ear) {
            initAudio(); stopTone();
            const pan = ear === 'left' ? -0.9 : 0.9;
            oscillator = audioContext.createOscillator();
            gainNode = audioContext.createGain();
            panner = audioContext.createStereoPanner();
            oscillator.frequency.value = 1000;
            gainNode.gain.value = 0.45;
            panner.pan.value = pan;
            oscillator.connect(gainNode).connect(panner).connect(audioContext.destination);
            oscillator.start();
            setTimeout(stopTone, 2500);
        }

        function recordThreshold() {
            const ear = document.getElementById('ear').value;
            const freq = parseInt(document.getElementById('frequency').value);
            const db = parseInt(document.getElementById('intensity').value);
            
            thresholds[ear][freq] = db;
            drawAudiogram(document.getElementById('audiogram'));
            alert(`✅ Recorded ${db} dB at ${freq} Hz for ${ear.toUpperCase()} ear`);
        }
	
		
		function drawAudiogram(canvas) {
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Grid
            ctx.strokeStyle = '#e5e7eb';
            for (let i = 0; i <= 9; i++) {
                ctx.beginPath();
                ctx.moveTo(80, 50 + i*32);
                ctx.lineTo(720, 50 + i*32);
                ctx.stroke();
            }

            // Y-axis label (rotated)
            ctx.save();
            ctx.translate(35, 220);
            ctx.rotate(-Math.PI / 2);
            ctx.fillStyle = '#1f2937';
            ctx.font = 'bold 16px Arial';
            ctx.fillText('← Hearing Level (dB HL)', -50, 0);
            ctx.restore();

            // X-axis label
            ctx.fillStyle = '#1f2937';
            ctx.font = 'bold 16px Arial';
            ctx.fillText('Frequency (Hz) →', 340, 395);

            // Frequency labels
            ctx.font = '14px Arial';
            const xPos = [100, 190, 290, 390, 490, 590];
            const freqs = [250, 500, 1000, 2000, 4000, 8000];
            freqs.forEach((f, i) => ctx.fillText(f, xPos[i]-12, 375));

            // dB labels
            ctx.font = '13px Arial';
            for (let db = 0; db <= 90; db += 10) {
                const y = 50 + (db / 10) * 32;
                ctx.fillText(db, 45, y + 4);
            }

            // Plot data
            drawEarData(ctx, thresholds.left, '#1e40af', 'X', xPos);
            drawEarData(ctx, thresholds.right, '#dc2626', 'O', xPos);
        }

        function drawEarData(ctx, data, color, symbol, xPositions) {
            ctx.strokeStyle = color;
            ctx.fillStyle = color;
            ctx.lineWidth = 3.5;
            ctx.font = 'bold 26px Arial';
            ctx.textAlign = 'center';

            let prevX = null, prevY = null;

            frequencies.forEach((f, i) => {
                if (data[f] !== undefined) {
                    const x = xPositions[i];
                    const y = 50 + (data[f] / 10) * 32;
                    
                    // Symbol
                    ctx.fillText(symbol, x, y + 8);
                    
                    // Connecting line
                    if (prevX !== null) {
                        ctx.beginPath();
                        ctx.moveTo(prevX, prevY);
                        ctx.lineTo(x, y);
                        ctx.stroke();
                    }
                    prevX = x;
                    prevY = y;
                }
            });
        }

       
		
		function nextSection(sectionId) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.getElementById(sectionId).classList.add('active');
            
            if (sectionId === 'mainapp') {
                drawAudiogram(document.getElementById('audiogram'));
            }
        }

        function showResults() {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.getElementById('results').classList.add('active');
            
            drawAudiogram(document.getElementById('final-audiogram'));
            
            // Calculate per ear
            let leftAvg = calculateAverage(thresholds.left);
            let rightAvg = calculateAverage(thresholds.right);
            
            let analysisHTML = `<h3>Test Analysis by BetterHealthFacts.com</h3>`;
            
            analysisHTML += `<p><strong>Left Ear Average:</strong> ${leftAvg} dB HL</p>`;
            analysisHTML += `<p><strong>Right Ear Average:</strong> ${rightAvg} dB HL</p>`;
            
            // Left Ear Conclusion
            analysisHTML += `<p><strong>Left Ear:</strong> `;
            if (leftAvg <= 25) analysisHTML += `Normal Hearing ✅`;
            else if (leftAvg <= 40) analysisHTML += `Mild Loss ⚠️`;
            else analysisHTML += `Moderate/Severe Loss 🔴`;
            analysisHTML += `</p>`;
            
            // Right Ear Conclusion
            analysisHTML += `<p><strong>Right Ear:</strong> `;
            if (rightAvg <= 25) analysisHTML += `Normal Hearing ✅`;
            else if (rightAvg <= 40) analysisHTML += `Mild Loss ⚠️`;
            else analysisHTML += `Moderate/Severe Loss 🔴`;
            analysisHTML += `</p>`;
            
            analysisHTML += `<p><strong>This is an approximate screening only.</strong></p>
                <p>Results can vary based on headphones, device volume, and environment.</p>
                <p><strong>Recommendation:</strong> For accurate diagnosis, please consult an ENT specialist or audiologist with professional equipment.</p>
                <p><em>This tool is for educational and awareness purposes only and is not a substitute for medical consultation.</em></p>`;
            
            document.getElementById('analysis').innerHTML = analysisHTML;
        }

        function calculateAverage(data) {
            const values = Object.values(data);
            if (values.length === 0) return "N/A";
            const sum = values.reduce((a, b) => a + b, 0);
            return Math.round(sum / values.length);
        }

        function restartApp() {
            if (confirm("Start a new test?")) {
                location.reload();
            }
        }

        // Live dB update
        document.getElementById('intensity').addEventListener('input', (e) => {
            document.getElementById('db-value').textContent = e.target.value;
        });

        window.onload = () => console.log("✅ Full Audiometer Ready");
		
		function saveAsPDF() {
            const originalTitle = document.title;
            document.title = "Hearing Test Report - Better Health Facts";
            
            // Optional: Hide unnecessary elements before printing
            const hideElements = document.querySelectorAll('#playBtn, button[onclick="toggleTone"]');
            hideElements.forEach(el => el.style.display = 'none');
            
            window.print();
            
            // Restore
            setTimeout(() => {
                document.title = originalTitle;
                hideElements.forEach(el => el.style.display = '');
            }, 1000);
        }
		
    </script>

    <style>
        .container {margin: auto; background: white; border-radius: 12px; box-shadow: 0 5px 25px rgba(0,0,0,0.15); overflow: hidden; text-align: center; }
        .header { background: #1e3a8a; color: white; padding: 20px; text-align: center; }
        .section { padding: 25px; display: none; }
        .active { display: block; }
        button { padding: 12px 24px; margin: 8px 4px; border: none; border-radius: 6px; cursor: pointer; font-size: 16px; }
        button.primary { background: #1e40af; color: white; }
        button.play { background: #15803d; font-size: 18px; padding: 16px 32px; }
        .playing { animation: pulse 1.2s infinite; }
        @keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.06); } }
        input[type="range"] { width: 100%; }
        canvas { border: 2px solid #ddd; border-radius: 8px; background: #fafafa; }
        .disclaimer { background: #fef3c7; padding: 18px; border-radius: 8px; margin: 20px 0; }
		@media print {
            body * { visibility: hidden; }
            #results, #results * { visibility: visible; }
            #results { position: absolute; left: 0; top: 0; width: 100%; }
            button { display: none !important; }
        }
    </style>