---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const PAGE_SIZE = 12;

  const articles = await getCollection('articles');

  const totalPages = Math.ceil(articles.length / PAGE_SIZE);

  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: String(i + 1) },
  }));
}

const PAGE_SIZE = 12;

const allArticles = await getCollection('articles');

const sorted = allArticles.sort(
  (a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)
);

const currentPage = Number(Astro.params.page);

const totalPages = Math.ceil(sorted.length / PAGE_SIZE);

const start = (currentPage - 1) * PAGE_SIZE;
const end = start + PAGE_SIZE;

const pageArticles = sorted.slice(start, end);
---

<MainLayout title={`Page ${currentPage} | Better Health Research`}>

  <section class="archive-page">

  <header class="page-header">
    <p>Page {currentPage} of {totalPages}</p>
  </header>

  <section class="articles-grid">

	  {pageArticles.map(article => (
		<article class="article-card">

		  <a href={`/articles/${article.slug}/`}>

			{article.data.image && (
			  <img
				src={article.data.image}
				alt={article.data.title}
				class="article-image"
				loading="lazy"
			  />
			)}

			<div class="card-title-overlay">
			  <span class="article-category">
				{article.data.category}
			  </span>
			  <h2>{article.data.title}</h2>
			</div>

		  </a>

		</article>
	  ))}

	</section>

  <nav class="pagination">

    {currentPage > 1 ? (
      <a
        href={
          currentPage === 2
            ? '/'
            : `/page/${currentPage - 1}/`
        }
      >
        ← Previous
      </a>
    ) : (
      <span></span>
    )}

    <span class="page-number">
      Page {currentPage} of {totalPages}
    </span>

    {currentPage < totalPages && (
      <a href={`/page/${currentPage + 1}/`}>
        Next →
      </a>
    )}

  </nav>

</section>

</MainLayout>

<style>
.archive-page {
  display: flex;
  flex-direction: column;
  gap: 30px;
}

.page-header {
  padding-top: 10px;
}

.page-header h1 {
  margin-bottom: 8px;
  font-size: clamp(2rem, 5vw, 3rem);
}

.page-header p {
  color: var(--muted);
}

.articles-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
}

.article-card {
  position: relative;
  border-radius: 18px;
  overflow: hidden;
  background: #0f172a;
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: 0.25s ease;
}

.article-card:hover {
  transform: translateY(-4px);
  border-color: rgba(125, 211, 252, 0.45);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
}

.article-card a {
  display: block;
  color: inherit;
  text-decoration: none;
  height: 100%;
}

.article-image {
  width: 100%;
  height: 240px;
  object-fit: cover;
  display: block;
}

/* Title + Category over image */
.card-title-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 28px 18px 18px;
  background: linear-gradient(
    to top,
    rgba(2, 6, 23, 0.92) 0%,
    rgba(2, 6, 23, 0.75) 55%,
    transparent 100%
  );
}

.card-title-overlay .article-category {
  display: block;
  margin-bottom: 8px;
  color: #7dd3fc;
  font-size: 0.75rem;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  font-weight: 700;
}

.card-title-overlay h2 {
  margin: 0;
  font-size: 1.15rem;
  line-height: 1.35;
  color: #f8fafc;
  font-weight: 600;
}


.article-category {
  display: inline-block;
  margin-bottom: 12px;
  color: #7dd3fc;
  font-size: 0.8rem;
  letter-spacing: 1px;
  text-transform: uppercase;
  font-weight: 700;
}


.pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10px;
}

.pagination a {
  padding: 12px 22px;
  border-radius: 999px;

  background: rgba(255,255,255,0.06);

  color: #f8fafc;

  border:
    1px solid rgba(255,255,255,0.08);

  transition: 0.2s ease;
}

.pagination a:hover {
  background:
    rgba(125,211,252,0.12);

  border-color:
    rgba(125,211,252,0.35);
}

.page-number {
  color: var(--muted);
  font-size: 0.95rem;
}

@media (max-width: 768px) {

  .articles-grid {
    gap: 18px;
  }

  .article-content {
    padding: 18px;
  }

  .pagination {
    flex-direction: column;
    gap: 14px;
  }

}
</style>
