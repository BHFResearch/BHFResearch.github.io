---
import { getCollection } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';


export async function getStaticPaths() {
	const PAGE_SIZE = 12;
  const articles = await getCollection('articles');
  const categories = [...new Set(articles.map(a => a.data.category))];

  const paths = [];

  for (const category of categories) {
    const filtered = articles.filter(a => a.data.category === category);
    const totalPages = Math.ceil(filtered.length / PAGE_SIZE);

    // Start from page 2
    for (let page = 2; page <= totalPages; page++) {
      paths.push({
        params: { 
          category,
          page: String(page)
        }
      });
    }
  }

  return paths;
}
const PAGE_SIZE = 12;

const { category, page } = Astro.params;
const currentPage = Number(page);

const allArticles = await getCollection('articles');

const filtered = allArticles
  .filter(a => a.data.category === category)
  .sort((a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate));

const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
const start = (currentPage - 1) * PAGE_SIZE;
const pageArticles = filtered.slice(start, start + PAGE_SIZE);
---

<MainLayout 
  title={`${category} – Page ${currentPage} | Better Health Research`}
  description={`Page ${currentPage} of articles in the ${category} category`}
>

  <h1 style="margin-bottom: 8px;">{category}</h1>
  <p style="color:#94a3b8; margin-bottom: 30px;">
    {filtered.length} article{filtered.length !== 1 ? 's' : ''} in this category
    · Page {currentPage} of {totalPages}
  </p>

  <section class="articles-grid">
    {pageArticles.map(article => (
      <article class="article-card">
        <a href={`/articles/${article.slug}/`}>
          {article.data.image && (
            <img
              src={article.data.image}
              alt={article.data.title}
              class="article-image"
              loading="lazy"
            />
          )}
        </a>

        <div class="card-title-overlay">
          <a href={`/articles/${article.slug}/`}>
            <h2>{article.data.title}</h2>
          </a>
        </div>
      </article>
    ))}
  </section>

  <nav class="pagination">
    <a href={
      currentPage === 2 
        ? `/category/${encodeURIComponent(category)}/` 
        : `/category/${encodeURIComponent(category)}/${currentPage - 1}/`
    }>
      ← Previous
    </a>

    <span class="page-number">Page {currentPage} of {totalPages}</span>

    {currentPage < totalPages ? (
      <a href={`/category/${encodeURIComponent(category)}/${currentPage + 1}/`}>
        Next →
      </a>
    ) : (
      <span></span>
    )}
  </nav>

</MainLayout>

<style>
.articles-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
}

.article-card {
  position: relative;
  border-radius: 18px;
  overflow: hidden;
  background: #0f172a;
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: 0.25s ease;
}

.article-card:hover {
  transform: translateY(-4px);
  border-color: rgba(125, 211, 252, 0.45);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
}

.article-card a {
  display: block;
  color: inherit;
  text-decoration: none;
  height: 100%;
}

.article-image {
  width: 100%;
  height: 240px;
  object-fit: cover;
  display: block;
}

.card-title-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 28px 18px 18px;
  background: linear-gradient(
    to top,
    rgba(2, 6, 23, 0.92) 0%,
    rgba(2, 6, 23, 0.75) 55%,
    transparent 100%
  );
}

.card-title-overlay h2 {
  margin: 0;
  font-size: 1.15rem;
  line-height: 1.35;
  color: #f8fafc;
  font-weight: 600;
}

.pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 40px;
}

.pagination a {
  padding: 12px 22px;
  border-radius: 999px;
  background: rgba(255,255,255,0.06);
  color: #f8fafc;
  border: 1px solid rgba(255,255,255,0.08);
  transition: 0.2s ease;
  text-decoration: none;
}

.pagination a:hover {
  background: rgba(125,211,252,0.12);
  border-color: rgba(125,211,252,0.35);
}

.page-number {
  color: #94a3b8;
  font-size: 0.95rem;
}
</style>