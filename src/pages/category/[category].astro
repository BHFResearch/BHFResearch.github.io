---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  const categories = [...new Set(
    articles.map(a => a.data.category)
  )];

  return categories.map(category => ({
    params: { category }
  }));
}

const { category } = Astro.params;

const allArticles = await getCollection('articles');

const filtered = allArticles
  .filter(a => a.data.category === category)
  .sort((a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate));
---

<MainLayout 
  title={`${category} | Better Health Research`}
  description={`Articles in the ${category} category on Research.BetterHealthFacts.com`}
>

  <h1 style="margin-bottom: 8px;">{category}</h1>
  <p style="color:#94a3b8; margin-bottom: 30px;">
    {filtered.length} article{filtered.length !== 1 ? 's' : ''} in this category
  </p>

  <section class="articles-grid">
    {filtered.map(article => (
      <article class="article-card">
        <a href={`/articles/${article.slug}/`}>
          {article.data.image && (
            <img
              src={article.data.image}
              alt={article.data.title}
              class="article-image"
              loading="lazy"
            />
          )}
          <div class="card-title-overlay">
            <h2>{article.data.title}</h2>
          </div>
        </a>
      </article>
    ))}
  </section>

</MainLayout>

<style>
.articles-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
}

.article-card {
  position: relative;
  border-radius: 18px;
  overflow: hidden;
  background: #0f172a;
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: 0.25s ease;
}

.article-card:hover {
  transform: translateY(-4px);
  border-color: rgba(125, 211, 252, 0.45);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
}

.article-card a {
  display: block;
  color: inherit;
  text-decoration: none;
  height: 100%;
}

.article-image {
  width: 100%;
  height: 240px;
  object-fit: cover;
  display: block;
}

.card-title-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 28px 18px 18px;
  background: linear-gradient(
    to top,
    rgba(2, 6, 23, 0.92) 0%,
    rgba(2, 6, 23, 0.75) 55%,
    transparent 100%
  );
}

.card-title-overlay h2 {
  margin: 0;
  font-size: 1.15rem;
  line-height: 1.35;
  color: #f8fafc;
  font-weight: 600;
}
</style>