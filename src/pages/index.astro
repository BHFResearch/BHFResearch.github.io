---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';

const articles = await getCollection('articles');

const sorted = articles.sort(
  (a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)
);

const hero = sorted.find(article => article.data.featured);

const latest = hero
  ? sorted.filter(article => article.slug !== hero.slug)
  : sorted;

const PAGE_SIZE = 12;

const homepageArticles = latest.slice(0, PAGE_SIZE);
---

<MainLayout
  title="Better Health Research"
  description="Research-backed health articles exploring medicine, neuroscience, biology, and human health."
>

<section class="homepage">

  {hero && (
    <section class="hero">
      <a href={`/articles/${hero.slug}/`} class="hero-link">

        {hero.data.image && (
          <img
            src={hero.data.image}
            alt={hero.data.title}
            class="hero-image"
            loading="eager"
            fetchpriority="high"
          />
        )}
	  </a>
        <div class="hero-overlay">
          <span class="hero-category">
            <a href={`/category/${encodeURIComponent(hero.data.category)}/`}>
				{hero.data.category}
			</a>
          </span>
		<a href={`/articles/${hero.slug}/`} class="hero-link">
          <h1>{hero.data.title}</h1>
          <p>{hero.data.description}</p>
		</a>
        </div>

      
    </section>
  )}
	<div class="site-intro">
	  <p>
		Research.BetterHealthFacts.com explores the science behind everyday body signals, 
		common symptoms, and modern lifestyle mismatches — written clearly, grounded in 
		research, and focused on what is normal versus what needs attention.
	  </p>
	</div>
  {!hero && (
    <header class="page-header">
      <h1>Latest Health Articles</h1>
      <p>
        Research-based articles about health, neuroscience,
        medicine, and the human body.
      </p>
    </header>
  )}

	<h2 style="margin: 10px 0 8px; font-size: 1.6rem;">Latest Articles</h2>

	<section class="articles-grid">

	  {homepageArticles.map(article => (
		<article class="article-card">

		  <a href={`/articles/${article.slug}/`}>
			{article.data.image && (
			  <img
				src={article.data.image}
				alt={article.data.title}
				class="article-image"
				loading="lazy"
			  />
			)}
		  </a>

		  <div class="card-title-overlay">
			<span class="article-category">
			  <a href={`/category/${encodeURIComponent(article.data.category)}/`}>
				{article.data.category}
			  </a>
			</span>

			<a href={`/articles/${article.slug}/`}>
			  <h2>{article.data.title}</h2>
			</a>
		  </div>

		</article>
	  ))}

	</section>

  {latest.length > PAGE_SIZE && (
	  <nav class="pagination">
		<a href="/page/2/">Older Articles →</a>
	  </nav>
	)}

</section>

<style>
  .homepage {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .page-header {
    padding: 10px 0 0;
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 10px;
    line-height: 1.1;
  }

  .page-header p {
    color: var(--muted);
    max-width: 700px;
    font-size: 1.05rem;
  }

  .hero {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    background: #111827;
  }

  .hero-link {
    display: block;
    position: relative;
  }

  .hero-image {
    width: 100%;
    height: 70vh;
    object-fit: cover;
    display: block;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: end;
    padding: 40px;
    background:
      linear-gradient(
        to top,
        rgba(0,0,0,0.88),
        rgba(0,0,0,0.25),
        rgba(0,0,0,0.05)
      );
  }

  .hero-category,
  .article-category {
    display: inline-block;
    margin-bottom: 12px;
    color: #7dd3fc;
    font-size: 0.8rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 700;
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 4.5rem);
    line-height: 1.05;
    margin: 0 0 15px;
    color: white;
    max-width: 900px;
  }

  .hero p {
    color: rgba(255,255,255,0.85);
    max-width: 700px;
    font-size: 1.1rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(280px, 1fr)
    );
    gap: 24px;
  }

	 .article-card {
	  position: relative;
	  border-radius: 18px;
	  overflow: hidden;
	  background: #0f172a;
	  border: 1px solid rgba(255, 255, 255, 0.1);
	  transition: 0.25s ease;
	}

	.article-card:hover {
	  transform: translateY(-4px);
	  border-color: rgba(125, 211, 252, 0.45);
	  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
	}

	.article-card a {
	  display: block;
	  color: inherit;
	  text-decoration: none;
	  height: 100%;
	}

	.article-image {
	  width: 100%;
	  height: 240px;
	  object-fit: cover;
	  display: block;
	}

	/* Title + Category over image */
	.card-title-overlay {
	  position: absolute;
	  bottom: 0;
	  left: 0;
	  right: 0;
	  padding: 28px 18px 18px;
	  background: linear-gradient(
		to top,
		rgba(2, 6, 23, 0.92) 0%,
		rgba(2, 6, 23, 0.75) 55%,
		transparent 100%
	  );
	}

	.card-title-overlay .article-category {
	  display: block;
	  margin-bottom: 8px;
	  color: #7dd3fc;
	  font-size: 0.75rem;
	  letter-spacing: 0.8px;
	  text-transform: uppercase;
	  font-weight: 700;
	}

	.card-title-overlay h2 {
	  margin: 0;
	  font-size: 1.15rem;
	  line-height: 1.35;
	  color: #f8fafc;
	  font-weight: 600;
	}
	
	.article-category {
	  display: inline-block;
	  margin-bottom: 12px;
	  color: #7dd3fc;
	  font-size: 0.8rem;
	  letter-spacing: 1px;
	  text-transform: uppercase;
	  font-weight: 700;
	}

	.site-intro {	  
	  margin: 10px 0 5px;
	}

	.site-intro p {
	  color: #94a3b8;
	  font-size: 1.05rem;
	  line-height: 1.65;
	  margin: 0;
	}

  .pagination {
	  display: flex;
	  justify-content: center;
	  margin-top: 10px;
	}

	.pagination a {
	  padding: 14px 24px;
	  border-radius: 999px;

	  background: rgba(255,255,255,0.06);

	  color: #f8fafc;
	  font-weight: 600;
	  letter-spacing: 0.3px;

	  border: 1px solid rgba(255,255,255,0.08);

	  transition:
		background 0.2s ease,
		border-color 0.2s ease,
		transform 0.2s ease;
	}

	.pagination a:hover {
	  background: rgba(125,211,252,0.12);
	  border-color: rgba(125,211,252,0.35);

	  transform: translateY(-2px);
	}

  @media (max-width: 768px) {

    .hero-image {
      height: 55vh;
    }

    .hero-overlay {
      padding: 24px;
    }

    .article-content {
      padding: 18px;
    }

    .articles-grid {
      gap: 18px;
    }
  }
</style>