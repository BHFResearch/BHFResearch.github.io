---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="Page Not Found | Better Health Research"
  description="The page you are looking for could not be found."
>

  <section class="not-found">
    <h1>404</h1>
    <h2>Page not found</h2>
    <p>
      The page you are looking for doesn’t exist or may have been moved.
    </p>

    <div class="actions">
      <a href="/" class="btn">Go to Homepage</a>
      <a href="/about/" class="btn-secondary">About Us</a>
    </div>
  </section>

</MainLayout>

<style>
  .not-found {
    text-align: center;
    padding: 80px 20px 100px;
    max-width: 600px;
    margin: 0 auto;
  }

  .not-found h1 {
    font-size: 6rem;
    margin: 0;
    color: #7dd3fc;
    line-height: 1;
  }

  .not-found h2 {
    font-size: 1.8rem;
    margin: 10px 0 20px;
    color: #f8fafc;
  }

  .not-found p {
    color: #94a3b8;
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 14px 28px;
    background: #7dd3fc;
    color: #0f172a;
    font-weight: 600;
    border-radius: 999px;
    text-decoration: none;
    transition: 0.2s ease;
  }

  .btn:hover {
    background: #bae6fd;
  }

  .btn-secondary {
    display: inline-block;
    padding: 14px 28px;
    background: transparent;
    color: #7dd3fc;
    font-weight: 600;
    border-radius: 999px;
    border: 1px solid rgba(125, 211, 252, 0.4);
    text-decoration: none;
    transition: 0.2s ease;
  }

  .btn-secondary:hover {
    background: rgba(125, 211, 252, 0.1);
    border-color: #7dd3fc;
  }
</style>