---
import MainLayout from '../layouts/MainLayout.astro';

const mainCategories = [
  "Movement & Posture",
  "Sleep & Recovery",
  "Heart & Circulation",
  "Digestion & Gut",
  "Skin & Senses",
  "Causes & Conditions"
];
---

<MainLayout 
  title="Page Not Found | Better Health Research"
  description="The page you are looking for could not be found."
>

  <section class="not-found">
    <h1>404</h1>
    <h2>Page not found</h2>
    <p>
      The page you are looking for doesn’t exist or may have been moved.
    </p>

    <div class="actions">
      <a href="/" class="btn">Go to Homepage</a>
    </div>

    <div class="categories">
      <h3>Browse by Category</h3>
      <div class="category-list">
        {mainCategories.map(category => (
          <a 
            href={`/category/${encodeURIComponent(category)}/`}
            class="category-link"
          >
            {category}
          </a>
        ))}
      </div>
    </div>
  </section>

</MainLayout>

<style>
  .not-found {
    text-align: center;
    padding: 80px 20px 100px;
    max-width: 700px;
    margin: 0 auto;
  }

  .not-found h1 {
    font-size: 6rem;
    margin: 0;
    color: #7dd3fc;
    line-height: 1;
  }

  .not-found h2 {
    font-size: 1.8rem;
    margin: 10px 0 20px;
    color: #f8fafc;
  }

  .not-found p {
    color: #94a3b8;
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 35px;
  }

  .actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    margin-bottom: 50px;
  }

  .btn {
    display: inline-block;
    padding: 14px 28px;
    background: #7dd3fc;
    color: #0f172a;
    font-weight: 600;
    border-radius: 999px;
    text-decoration: none;
    transition: 0.2s ease;
  }

  .btn:hover {
    background: #bae6fd;
  }

  .categories h3 {
    font-size: 1.15rem;
    color: #f8fafc;
    margin-bottom: 18px;
    font-weight: 600;
  }

  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .category-link {
    display: inline-block;
    padding: 10px 18px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    color: #7dd3fc;
    text-decoration: none;
    font-size: 0.95rem;
    transition: 0.2s ease;
  }

  .category-link:hover {
    background: rgba(125, 211, 252, 0.12);
    border-color: rgba(125, 211, 252, 0.4);
    color: #bae6fd;
  }
</style>