---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();

const allArticles = await getCollection('articles');

const related = allArticles
  .filter(a =>
    a.data?.category &&
    article.data?.category &&
    a.data.category === article.data.category &&
    a.slug !== article.slug
  )
  .slice(0, 3);
---

<MainLayout title={article.data.title} description={article.data.description}>

  <div class="article-page">

    <!-- Title & Meta -->
    <div class="article-header">
      <h1 style="color:#6cf1e0;">{article.data.title}</h1>

      <p class="article-meta">
        Published on: {article.data.pubDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        })}
        <span class="separator">·</span>
        <a href={`/category/${encodeURIComponent(article.data.category)}/`}>
          {article.data.category}
        </a>
      </p>


    </div>

    <!-- Article Content -->
    <article class="article-content">
	  {article.data.description && (
        <p class="article-description">{article.data.description}</p>
      )}
      <Content />
    </article>

    <!-- Related Articles -->
    <hr class="divider" />

    <h3 class="related-title">Related Articles</h3>

    <div class="related-grid">
      {related.map(item => (
        <div class="card">
          <a href={`/articles/${item.slug}/`}>
            {item.data.image && (
              <img 
                src={item.data.image} 
                alt={item.data.title}
                loading="lazy"
              />
            )}
            <div class="card-title-overlay">
              <h4>{item.data.title}</h4>
            </div>
          </a>
        </div>
      ))}
    </div>

  </div>

</MainLayout>

<style>
  .article-page {
    max-width: 780px;
    margin: 0 auto;
    padding: 10px 0 60px;
  }

  /* Header */
  .article-header {
    margin-bottom: 40px;
  }

  .article-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.25;
    margin: 0 0 16px;
    color: #f8fafc;
  }

  .article-meta {
    color: #94a3b8;
    font-size: 0.95rem;
    margin: 0 0 20px;
  }

  .article-meta .separator {
    margin: 0 8px;
    opacity: 0.6;
  }

  .article-meta a {
    color: #7dd3fc;
    text-decoration: none;
  }

  .article-meta a:hover {
    text-decoration: underline;
    color: #bae6fd;
  }

  .article-description {
    color: #cbd5e1;
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Article Content - Main Reading Styles */
  .article-content {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #e2e8f0;
  }

  .article-content :global(h2) {
    font-size: 1.55rem;
    margin: 48px 0 18px;
    color: #f8fafc;
    line-height: 1.3;
  }

  .article-content :global(h3) {
    font-size: 1.3rem;
    margin: 36px 0 14px;
    color: #f1f5f9;
    line-height: 1.35;
  }

  .article-content :global(p) {
    margin: 0 0 22px;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 24px;
    padding-left: 1.4rem;
  }

  .article-content :global(li) {
    margin-bottom: 10px;
    line-height: 1.7;
  }

  .article-content :global(a) {
    color: #7dd3fc;
    text-decoration: none;
    border-bottom: 1px solid rgba(125, 211, 252, 0.35);
  }

  .article-content :global(a:hover) {
    color: #bae6fd;
    border-bottom-color: #bae6fd;
  }

  .article-content :global(strong) {
    color: #f8fafc;
    font-weight: 600;
  }

  .article-content :global(blockquote) {
    margin: 28px 0;
    padding: 16px 20px;
    border-left: 3px solid #7dd3fc;
    background: rgba(125, 211, 252, 0.06);
    color: #cbd5e1;
    border-radius: 0 8px 8px 0;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 28px 0;
  }

  .article-content :global(hr) {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.1);
    margin: 40px 0;
  }

  /* Related Articles */
  .divider {
    margin: 50px 0 30px;
    border: none;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .related-title {
    margin-bottom: 20px;
    font-size: 1.4rem;
    color: #f8fafc;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 800px) {
    .related-grid {
      grid-template-columns: 1fr;
    }

    .article-page {
      padding: 0 0 40px;
    }
  }

  /* Related Cards (reuse existing style) */
  .card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: 0.25s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: rgba(125, 211, 252, 0.45);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
  }

  .card a {
    display: block;
    color: inherit;
    text-decoration: none;
    height: 100%;
  }

  .card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    display: block;
  }

  .card-title-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px 16px 16px;
    background: linear-gradient(
      to top,
      rgba(2, 6, 23, 0.92) 0%,
      rgba(2, 6, 23, 0.75) 55%,
      transparent 100%
    );
  }

  .card-title-overlay h4 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.35;
    color: #f8fafc;
    font-weight: 600;
  }
  
  .article-content :global(blockquote) {
	  margin: 28px 0;
	  padding: 18px 22px;
	  border-left: 4px solid #2dd4bf;
	  background: rgba(45, 212, 191, 0.08);
	  border-radius: 0 12px 12px 0;
	  color: #e2e8f0;
	  font-size: 1.05rem;
	  line-height: 1.7;
	  font-style: italic;
	}

	.article-content :global(blockquote p) {
	  margin: 0;
	}

	.article-content :global(blockquote strong),
	.article-content :global(blockquote cite) {
	  display: block;
	  margin-top: 10px;
	  font-style: normal;
	  font-weight: 600;
	  color: #99f6e4;
	  font-size: 0.95rem;
	}
</style>